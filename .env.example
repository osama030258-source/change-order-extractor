# Copy to .env and fill in. NEVER commit .env and never paste keys into chats/issues.
LLM_PROVIDER=groq

GROQ_API_KEY=
# Model names change over time; check https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Optional: switch with LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
